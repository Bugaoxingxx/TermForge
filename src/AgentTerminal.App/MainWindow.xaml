<Window x:Class="AgentTerminal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AgentTerminal.App.ViewModels"
        xmlns:dockingControls="clr-namespace:AgentTerminal.Docking.Controls;assembly=AgentTerminal.Docking"
        xmlns:dockingVm="clr-namespace:AgentTerminal.Docking.ViewModels;assembly=AgentTerminal.Docking"
        xmlns:views="clr-namespace:AgentTerminal.App.Views"
        xmlns:terminalRendering="clr-namespace:AgentTerminal.Terminal.Rendering;assembly=AgentTerminal.Terminal"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="750" Width="1200"
        Icon="Assets/termforge.ico"
        AutomationProperties.AutomationId="MainWindow"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource AeroMainWindowChromeStyle}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Closing="OnWindowClosing">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- 将 TerminalDocumentViewModel 映射为原生 TerminalControl 呈现；支持切换诊断模式 -->
        <DataTemplate DataType="{x:Type dockingVm:TerminalDocumentViewModel}">
            <Grid>
                <!-- 原生高性能字符网格终端控件 (默认主视图) -->
                <terminalRendering:TerminalControl
                    Buffer="{Binding Buffer}"
                    Session="{Binding Session}"
                    AutomationProperties.AutomationId="MainTerminalControl">
                    <terminalRendering:TerminalControl.Style>
                        <Style TargetType="{x:Type terminalRendering:TerminalControl}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDiagnosticMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </terminalRendering:TerminalControl.Style>
                </terminalRendering:TerminalControl>

                <!-- 原始输出调试视图 (可选诊断模式) -->
                <views:TerminalDebugView>
                    <views:TerminalDebugView.Style>
                        <Style TargetType="{x:Type views:TerminalDebugView}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDiagnosticMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:TerminalDebugView.Style>
                </views:TerminalDebugView>
            </Grid>
        </DataTemplate>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: Explorer 经典菜单栏 -->
            <RowDefinition Height="Auto" /> <!-- 1: Explorer 经典工具栏 -->
            <RowDefinition Height="*" />    <!-- 2: MMC 3 栏主工作区 -->
            <RowDefinition Height="Auto" /> <!-- 3: Win7 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 0. Explorer 经典菜单栏 (文件、视图、窗口、帮助)             -->
        <!-- ========================================================= -->
        <Menu Grid.Row="0" Background="{DynamicResource AeroMenuBarBrush}" Foreground="#1E395B"
              Padding="6,2" BorderBrush="#CDD1D9" BorderThickness="0,0,0,1"
              FontFamily="Segoe UI, Tahoma" FontSize="11"
              AutomationProperties.AutomationId="MainMenu">
                    <!-- 文件菜单 -->
                    <MenuItem Header="文件(_F)" AutomationProperties.AutomationId="Menu.File">
                        <MenuItem Header="新建终端(_N)" InputGestureText="Ctrl+N" Command="{Binding NewTerminalCommand}"
                                  AutomationProperties.AutomationId="Menu.File.NewTerminal" />
                        <MenuItem Header="新建指定 Shell" ItemsSource="{Binding AvailableProfiles}"
                                  AutomationProperties.AutomationId="Menu.File.NewProfileTerminal">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="Command" Value="{Binding DataContext.NewTerminalCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="关闭当前文档(_C)" InputGestureText="Ctrl+F4" Command="{Binding CloseTerminalCommand}"
                                  AutomationProperties.AutomationId="Menu.File.CloseTerminal" />
                        <Separator />
                        <MenuItem Header="退出(_X)" Click="OnMenuExitClick" InputGestureText="Alt+F4"
                                  AutomationProperties.AutomationId="Menu.File.Exit" />
                    </MenuItem>

                    <!-- 视图菜单 -->
                    <MenuItem Header="视图(_V)" AutomationProperties.AutomationId="Menu.View">
                        <MenuItem Header="左侧导航树" IsCheckable="True" IsChecked="{Binding IsNavigationPaneVisible}"
                                  AutomationProperties.AutomationId="Menu.View.ToggleNav" />
                        <MenuItem Header="右侧属性面板" IsCheckable="True" IsChecked="{Binding IsPropertiesPaneVisible}"
                                  AutomationProperties.AutomationId="Menu.View.ToggleProps" />
                        <MenuItem Header="底部诊断日志" IsCheckable="True" IsChecked="{Binding IsLogPaneVisible}"
                                  AutomationProperties.AutomationId="Menu.View.ToggleLogs" />
                        <Separator />
                        <MenuItem Header="原始输出诊断模式" IsCheckable="True" IsChecked="{Binding ActiveDocument.IsDiagnosticMode}"
                                  AutomationProperties.AutomationId="Menu.View.ToggleDiagnostic" />
                    </MenuItem>

                    <!-- 窗口菜单 (Win32 MDI 核心：层叠、平铺、还原与动态文档列表) -->
                    <MenuItem Header="窗口(_W)" SubmenuOpened="OnWindowMenuOpened" AutomationProperties.AutomationId="Menu.Window">
                        <MenuItem Header="层叠(_C)" Command="{Binding CascadeCommand}" AutomationProperties.AutomationId="Menu.Window.Cascade" />
                        <MenuItem Header="水平平铺 (上下)(_H)" Command="{Binding TileHorizontalCommand}" AutomationProperties.AutomationId="Menu.Window.TileHorizontal" />
                        <MenuItem Header="垂直平铺 (左右)(_V)" Command="{Binding TileVerticalCommand}" AutomationProperties.AutomationId="Menu.Window.TileVertical" />
                        <MenuItem Header="全部还原(_R)" Command="{Binding RestoreAllCommand}" AutomationProperties.AutomationId="Menu.Window.RestoreAll" />
                        <Separator />
                        <MenuItem Header="打开的文档列表" x:Name="WindowsListMenuItem" AutomationProperties.AutomationId="Menu.Window.WindowsList" />
                    </MenuItem>

                    <!-- 帮助菜单 -->
                    <MenuItem Header="帮助(_H)" AutomationProperties.AutomationId="Menu.Help">
                        <MenuItem Header="关于 TermForge" Click="OnMenuAboutClick" AutomationProperties.AutomationId="Menu.Help.About" />
                    </MenuItem>
                </Menu>

        <!-- ========================================================= -->
        <!-- 1. Explorer 经典工具栏 (胶囊按钮 + 蚀刻分割线)               -->
        <!-- ========================================================= -->
        <!-- ========================================================= -->
        <!-- 1. Explorer 经典工具栏 (胶囊按钮 + 矢量图标 + 蚀刻分割线)    -->
        <!-- ========================================================= -->
        <ToolBarTray Grid.Row="1" Background="{DynamicResource AeroToolBarBrush}">
            <ToolBar Background="{DynamicResource AeroToolBarBrush}" ToolBarTray.IsLocked="True" Padding="4,2"
                     BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AeroBorderEdgeBrush}"
                     AutomationProperties.AutomationId="MainToolBar">
                <Button Style="{DynamicResource AeroToolBarButtonStyle}"
                        Command="{Binding NewTerminalCommand}" ToolTip="新建 PowerShell 终端 (Ctrl+N)"
                        AutomationProperties.AutomationId="Toolbar.BtnNewTerminal">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{DynamicResource NewTerminalIcon}" Width="16" Height="16" Margin="0,0,4,0" />
                        <TextBlock Text="新建终端" VerticalAlignment="Center" Foreground="{DynamicResource AeroTextDarkBrush}" />
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource AeroToolBarButtonStyle}"
                        Command="{Binding ActiveDocument.StopCommand}" ToolTip="停止当前活动会话"
                        AutomationProperties.AutomationId="Toolbar.BtnStopSession" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{DynamicResource StopSessionIcon}" Width="16" Height="16" Margin="0,0,4,0" />
                        <TextBlock Text="停止会话" VerticalAlignment="Center" Foreground="{DynamicResource AeroTextDarkBrush}" />
                    </StackPanel>
                </Button>
                <Separator Style="{DynamicResource AeroToolBarSeparatorStyle}" />
                <Button Style="{DynamicResource AeroToolBarButtonStyle}"
                        Command="{Binding CascadeCommand}" ToolTip="层叠排布子窗口"
                        AutomationProperties.AutomationId="Toolbar.BtnCascade" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{DynamicResource CascadeIcon}" Width="16" Height="16" Margin="0,0,4,0" />
                        <TextBlock Text="层叠" VerticalAlignment="Center" Foreground="{DynamicResource AeroTextDarkBrush}" />
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource AeroToolBarButtonStyle}"
                        Command="{Binding TileHorizontalCommand}" ToolTip="水平平铺 (上下排列)"
                        AutomationProperties.AutomationId="Toolbar.BtnTileHorizontal" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{DynamicResource TileHorizontalIcon}" Width="16" Height="16" Margin="0,0,4,0" />
                        <TextBlock Text="水平平铺" VerticalAlignment="Center" Foreground="{DynamicResource AeroTextDarkBrush}" />
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource AeroToolBarButtonStyle}"
                        Command="{Binding TileVerticalCommand}" ToolTip="垂直平铺 (左右排列)"
                        AutomationProperties.AutomationId="Toolbar.BtnTileVertical" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{DynamicResource TileVerticalIcon}" Width="16" Height="16" Margin="0,0,4,0" />
                        <TextBlock Text="垂直平铺" VerticalAlignment="Center" Foreground="{DynamicResource AeroTextDarkBrush}" />
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource AeroToolBarButtonStyle}"
                        Command="{Binding RestoreAllCommand}" ToolTip="全部还原"
                        AutomationProperties.AutomationId="Toolbar.BtnRestoreAll" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{DynamicResource RestoreAllIcon}" Width="16" Height="16" Margin="0,0,4,0" />
                        <TextBlock Text="还原" VerticalAlignment="Center" Foreground="{DynamicResource AeroTextDarkBrush}" />
                    </StackPanel>
                </Button>
                <Separator Style="{DynamicResource AeroToolBarSeparatorStyle}" />
                <Button Style="{DynamicResource AeroToolBarButtonStyle}"
                        Command="{Binding ActiveDocument.ClearOutputCommand}" ToolTip="清空当前调试窗口文本"
                        AutomationProperties.AutomationId="Toolbar.BtnClearOutput" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{DynamicResource ClearOutputIcon}" Width="16" Height="16" Margin="0,0,4,0" />
                        <TextBlock Text="清空输出" VerticalAlignment="Center" Foreground="{DynamicResource AeroTextDarkBrush}" />
                    </StackPanel>
                </Button>
                <Separator Style="{DynamicResource AeroToolBarSeparatorStyle}" />
                <Button Style="{DynamicResource AeroToolBarButtonStyle}"
                        Command="{Binding ActiveDocument.ToggleDiagnosticModeCommand}" ToolTip="切换原生终端 / 原始输出诊断模式"
                        AutomationProperties.AutomationId="Toolbar.BtnToggleDiagnostic" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{DynamicResource DiagnosticIcon}" Width="16" Height="16" Margin="0,0,4,0" />
                        <TextBlock Text="诊断模式" VerticalAlignment="Center" Foreground="{DynamicResource AeroTextDarkBrush}" />
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- ========================================================= -->
        <!-- 2. MMC 主工作区三栏布局 (左侧树 + 中央 MDI + 右侧属性)       -->
        <!-- ========================================================= -->
        <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="140" MaxWidth="400" /> <!-- 左侧导航树 -->
                        <ColumnDefinition Width="Auto" />                               <!-- 分割条 -->
                        <ColumnDefinition Width="*" MinWidth="300" />                   <!-- 中央 MDI 工作区 -->
                        <ColumnDefinition Width="Auto" />                               <!-- 分割条 -->
                        <ColumnDefinition Width="260" MinWidth="160" MaxWidth="450" /> <!-- 右侧属性区 -->
                    </Grid.ColumnDefinitions>

                    <!-- 3.1 左侧 MMC 导航树 (Windows 7 Explorer 浅色淡雅风格) -->
                    <dockingControls:WorkbenchPane Grid.Column="0"
                                    AutomationProperties.AutomationId="Pane.Navigation"
                                    AutomationProperties.Name="导航窗格"
                                    Visibility="{Binding IsNavigationPaneVisible, Converter={StaticResource BoolToVis}}">
                        <Border Background="{DynamicResource AeroPanelBackgroundBrush}" BorderBrush="{DynamicResource AeroBorderEdgeBrush}" BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource AeroMenuBarBrush}" Padding="8,6" BorderBrush="{DynamicResource AeroBorderEdgeBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="控制台导航" FontWeight="Bold" Foreground="{DynamicResource AeroTextDarkBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" FontFamily="{DynamicResource AeroFontFamily}" />
                                </Border>

                                <TreeView Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="4"
                                          AutomationProperties.AutomationId="Pane.Navigation.Tree">
                                    <!-- 活动会话树 -->
                                    <TreeViewItem Header="活动终端会话" IsExpanded="True" FontWeight="SemiBold"
                                                  Style="{DynamicResource AeroTreeViewItemStyle}">
                                        <TreeViewItem.ItemsSource>
                                            <Binding Path="Documents" />
                                        </TreeViewItem.ItemsSource>
                                        <TreeViewItem.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2" Cursor="Hand" MouseLeftButtonDown="OnNavigationItemClicked">
                                                    <Image Source="{DynamicResource SessionIcon}" Width="14" Height="14" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AeroTextDarkBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </TreeViewItem.ItemTemplate>
                                    </TreeViewItem>

                                    <!-- Shell 配置入口 -->
                                    <TreeViewItem Header="新建会话配置" IsExpanded="True" FontWeight="SemiBold" Margin="0,6,0,0"
                                                  Style="{DynamicResource AeroTreeViewItemStyle}">
                                        <TreeViewItem.ItemsSource>
                                            <Binding Path="AvailableProfiles" />
                                        </TreeViewItem.ItemsSource>
                                        <TreeViewItem.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2" Cursor="Hand" MouseLeftButtonDown="OnProfileNavigationItemClicked">
                                                    <Image Source="{DynamicResource ProfileIcon}" Width="12" Height="12" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource AeroTextDarkBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </TreeViewItem.ItemTemplate>
                                    </TreeViewItem>
                                </TreeView>
                            </Grid>
                        </Border>
                    </dockingControls:WorkbenchPane>

                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource AeroSplitterBrush}"
                                  Visibility="{Binding IsNavigationPaneVisible, Converter={StaticResource BoolToVis}}" />

                    <!-- 3.2 中央 MDI 工作区与底部日志区 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="200" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="140" MinHeight="60" MaxHeight="350" />
                        </Grid.RowDefinitions>

                        <!-- 中央 MDI 画布容器 -->
                        <dockingControls:MdiContainer Grid.Row="0" x:Name="MainMdiContainer"
                                                     ItemsSource="{Binding Documents}"
                                                     AutomationProperties.AutomationId="Workbench.MdiContainer"
                                                     SizeChanged="OnMdiContainerSizeChanged" />

                        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource AeroSplitterBrush}"
                                      Visibility="{Binding IsLogPaneVisible, Converter={StaticResource BoolToVis}}" />

                        <!-- 底部诊断日志区 (轻量 MMC 日志风格) -->
                        <dockingControls:WorkbenchPane Grid.Row="2"
                                        AutomationProperties.AutomationId="Pane.Diagnostics"
                                        AutomationProperties.Name="诊断日志"
                                        Visibility="{Binding IsLogPaneVisible, Converter={StaticResource BoolToVis}}">
                            <Border Background="{DynamicResource AeroDiagnosticsBackgroundBrush}" BorderBrush="{DynamicResource AeroBorderEdgeBrush}" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="{DynamicResource AeroMenuBarBrush}" Padding="6,4" BorderBrush="{DynamicResource AeroBorderEdgeBrush}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="运行诊断日志" FontWeight="Bold" Foreground="{DynamicResource AeroTextDarkBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" FontFamily="{DynamicResource AeroFontFamily}" />
                                    </Border>

                                    <TextBox Grid.Row="1" IsReadOnly="True" Background="#FFFFFF" Foreground="{DynamicResource AeroTextNormalBrush}" BorderThickness="0"
                                             AutomationProperties.AutomationId="Pane.Diagnostics.Text"
                                             AutomationProperties.Name="诊断日志"
                                             FontFamily="{DynamicResource AeroCodeFontFamily}" FontSize="{DynamicResource AeroFontSizeSmall}" Padding="6" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             Text="[系统就绪] TermForge Windows 7 Aero MMC MDI 终端工作台已初始化完成。支持自由拖拽、层叠、平铺与 PowerShell 7 会话闭环。" />
                                </Grid>
                            </Border>
                        </dockingControls:WorkbenchPane>
                    </Grid>

                    <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource AeroSplitterBrush}"
                                  Visibility="{Binding IsPropertiesPaneVisible, Converter={StaticResource BoolToVis}}" />

                    <!-- 3.3 右侧 MMC 属性面板 (轻量 MMC 检查器风格) -->
                    <dockingControls:WorkbenchPane Grid.Column="4"
                                    AutomationProperties.AutomationId="Pane.Properties"
                                    AutomationProperties.Name="属性面板"
                                    Visibility="{Binding IsPropertiesPaneVisible, Converter={StaticResource BoolToVis}}">
                        <Border Background="{DynamicResource AeroPropertiesBackgroundBrush}" BorderBrush="{DynamicResource AeroBorderEdgeBrush}" BorderThickness="1,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource AeroMenuBarBrush}" Padding="8,6" BorderBrush="{DynamicResource AeroBorderEdgeBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="文档属性" FontWeight="Bold" Foreground="{DynamicResource AeroTextDarkBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" FontFamily="{DynamicResource AeroFontFamily}" />
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8"
                                              AutomationProperties.AutomationId="Pane.Properties.Scroll">
                                    <StackPanel Orientation="Vertical">
                                        <!-- 基本属性 -->
                                        <Border Background="#FFFFFF" BorderBrush="{DynamicResource AeroSplitterBrush}" BorderThickness="1" Padding="7" Margin="0,0,0,7">
                                            <StackPanel>
                                                <TextBlock Text="基本属性" FontWeight="Bold" Foreground="{DynamicResource AeroTextDarkBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" Margin="0,0,0,5" />

                                                <TextBlock Text="文档标题:" Foreground="{DynamicResource AeroTextMutedBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" />
                                                <TextBlock Text="{Binding ActiveDocument.Title, TargetNullValue='(未选中文档)'}" Foreground="{DynamicResource AeroTextNormalBrush}" FontWeight="SemiBold" FontSize="{DynamicResource AeroFontSizeSmall}" Margin="0,2,0,6" />

                                                <TextBlock Text="会话标识:" Foreground="{DynamicResource AeroTextMutedBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" />
                                                <TextBox Text="{Binding ActiveDocument.Id, Mode=OneWay, TargetNullValue='N/A'}" IsReadOnly="True" Background="#F7F9FC" Foreground="{DynamicResource AeroTextDarkBrush}" BorderBrush="{DynamicResource AeroSplitterBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" Margin="0,2,0,6" />

                                                <TextBlock Text="生命周期状态:" Foreground="{DynamicResource AeroTextMutedBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" />
                                                <TextBlock Text="{Binding ActiveDocument.State, TargetNullValue='N/A'}" Foreground="{DynamicResource AeroTextSuccessBrush}" FontWeight="Bold" FontSize="{DynamicResource AeroFontSizeSmall}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 进程与环境 -->
                                        <Border Background="#FFFFFF" BorderBrush="{DynamicResource AeroSplitterBrush}" BorderThickness="1" Padding="7">
                                            <StackPanel>
                                                <TextBlock Text="进程与环境" FontWeight="Bold" Foreground="{DynamicResource AeroTextDarkBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" Margin="0,0,0,5" />

                                                <TextBlock Text="进程标识 (PID):" Foreground="{DynamicResource AeroTextMutedBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" />
                                                <TextBlock Text="{Binding ActiveDocument.ProcessId, TargetNullValue='N/A'}" Foreground="{DynamicResource AeroTextNormalBrush}" FontWeight="SemiBold" FontSize="{DynamicResource AeroFontSizeSmall}" Margin="0,2,0,6" />

                                                <TextBlock Text="退出代码:" Foreground="{DynamicResource AeroTextMutedBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" />
                                                <TextBlock Text="{Binding ActiveDocument.ExitCode, TargetNullValue='N/A'}" Foreground="{DynamicResource AeroTextNormalBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" Margin="0,2,0,6" />

                                                <TextBlock Text="视口规格:" Foreground="{DynamicResource AeroTextMutedBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                                    <TextBlock Text="{Binding ActiveDocument.Columns, TargetNullValue='120'}" Foreground="{DynamicResource AeroTextNormalBrush}" FontWeight="SemiBold" FontSize="{DynamicResource AeroFontSizeSmall}" />
                                                    <TextBlock Text=" 列 x " Foreground="{DynamicResource AeroTextMutedBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" />
                                                    <TextBlock Text="{Binding ActiveDocument.Rows, TargetNullValue='30'}" Foreground="{DynamicResource AeroTextNormalBrush}" FontWeight="SemiBold" FontSize="{DynamicResource AeroFontSizeSmall}" />
                                                    <TextBlock Text=" 行" Foreground="{DynamicResource AeroTextMutedBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" />
                                                </StackPanel>

                                                <TextBlock Text="工作目录:" Foreground="{DynamicResource AeroTextMutedBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" />
                                                <TextBox Text="{Binding ActiveDocument.Profile.WorkingDirectory, Mode=OneWay, TargetNullValue='(当前工作目录)'}" IsReadOnly="True" Background="#F7F9FC" Foreground="{DynamicResource AeroTextDarkBrush}" BorderBrush="{DynamicResource AeroSplitterBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" Margin="0,2,0,6" TextWrapping="Wrap" />

                                                <TextBlock Text="可执行程序:" Foreground="{DynamicResource AeroTextMutedBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" />
                                                <TextBox Text="{Binding ActiveDocument.Profile.ExecutablePath, Mode=OneWay, TargetNullValue='N/A'}" IsReadOnly="True" Background="#F7F9FC" Foreground="{DynamicResource AeroTextDarkBrush}" BorderBrush="{DynamicResource AeroSplitterBrush}" FontSize="{DynamicResource AeroFontSizeSmall}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </dockingControls:WorkbenchPane>
                </Grid>

        <!-- ========================================================= -->
        <!-- 3. Windows 7 经典底部状态栏 (银灰阶梯渐变 + 缩放把手)         -->
        <!-- ========================================================= -->
        <StatusBar Grid.Row="3" Background="{DynamicResource AeroStatusBarBrush}" Foreground="{DynamicResource AeroTextDarkBrush}"
                   Padding="6,2" BorderBrush="{DynamicResource AeroBorderEdgeBrush}" BorderThickness="0,1,0,0"
                   FontFamily="{DynamicResource AeroFontFamily}" FontSize="{DynamicResource AeroFontSizeSmall}"
                   Height="{DynamicResource AeroStatusBarHeight}"
                   AutomationProperties.AutomationId="Workbench.StatusBar">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" FontSize="{DynamicResource AeroFontSizeSmall}"
                           AutomationProperties.AutomationId="Workbench.StatusBar.StatusMessage" />
            </StatusBarItem>
            <Separator Style="{DynamicResource AeroToolBarSeparatorStyle}" />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="活动文档: " FontSize="{DynamicResource AeroFontSizeSmall}" Foreground="{DynamicResource AeroTextMutedBrush}" />
                    <TextBlock Text="{Binding ActiveDocument.Title, TargetNullValue='无'}" FontSize="{DynamicResource AeroFontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource AeroTextDarkBrush}"
                               AutomationProperties.AutomationId="Workbench.StatusBar.ActiveDocTitle" />
                </StackPanel>
            </StatusBarItem>
            <Separator Style="{DynamicResource AeroToolBarSeparatorStyle}" />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="就绪" FontSize="{DynamicResource AeroFontSizeSmall}" Foreground="{DynamicResource AeroTextMutedBrush}" Margin="0,0,12,0" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
