<UserControl x:Class="AgentTerminal.App.Views.TerminalDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AgentTerminal.Docking.ViewModels;assembly=AgentTerminal.Docking"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TerminalDocumentViewModel}"
             d:DesignHeight="500" d:DesignWidth="700">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 顶部状态与配置栏 -->
            <RowDefinition Height="*" />    <!-- 中间只读调试输出区 -->
            <RowDefinition Height="Auto" /> <!-- 底部命令行与控制区 -->
        </Grid.RowDefinitions>

        <!-- 顶部启动配置与状态面板 -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="Shell: " Foreground="#858585" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Text="{Binding Profile.ExecutablePath}" Foreground="#DCDCDC" FontSize="11" Margin="0,0,10,0" />
                        <TextBlock Text="Args: " Foreground="#858585" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Text="{Binding Profile.Arguments}" Foreground="#DCDCDC" FontSize="11" Margin="0,0,10,0" />
                        <TextBlock Text="WorkDir: " Foreground="#858585" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Text="{Binding Profile.WorkingDirectory, TargetNullValue='(当前目录)'}" Foreground="#DCDCDC" FontSize="11" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="状态: " Foreground="#858585" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Text="{Binding StatusMessage}" AutomationProperties.AutomationId="DebugView.TxtState" Foreground="#4EC9B0" FontSize="11" FontWeight="Bold" Margin="0,0,12,0" />
                        <TextBlock Text="视口: " Foreground="#858585" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Text="{Binding Columns}" AutomationProperties.AutomationId="DebugView.TxtColsDisplay" Foreground="#DCDCDC" FontSize="11" />
                        <TextBlock Text="x" Foreground="#858585" FontSize="11" />
                        <TextBlock Text="{Binding Rows}" AutomationProperties.AutomationId="DebugView.TxtRowsDisplay" Foreground="#DCDCDC" FontSize="11" Margin="0,0,12,0" />
                        <TextBlock Text="退出码: " Foreground="#858585" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Text="{Binding ExitCode, TargetNullValue='N/A'}" AutomationProperties.AutomationId="DebugView.TxtExitCode" Foreground="#DCDCDC" FontSize="11" Margin="0,0,12,0" />
                        <TextBlock Text="PID: " Foreground="#858585" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Text="{Binding ProcessId, TargetNullValue='N/A'}" AutomationProperties.AutomationId="DebugView.TxtPid" Foreground="#DCDCDC" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- 快速启停操作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▶ 启动" Command="{Binding StartCommand}" Width="65" Height="26" Margin="0,0,6,0"
                            AutomationProperties.AutomationId="DebugView.BtnStart"
                            Background="#0E639C" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
                    <Button Content="■ 停止" Command="{Binding StopCommand}" Width="65" Height="26" Margin="0,0,6,0"
                            AutomationProperties.AutomationId="DebugView.BtnStop"
                            Background="#8A1C1C" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
                    <Button Content="清空显示" Command="{Binding ClearOutputCommand}" Width="70" Height="26"
                            AutomationProperties.AutomationId="DebugView.BtnClear"
                            Background="#333337" Foreground="#CCCCCC" BorderBrush="#555555" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中部只读调试输出区 -->
        <Border Grid.Row="1" Background="#0C0C0C" Padding="4">
            <TextBox x:Name="OutputTextBox"
                     AutomationProperties.AutomationId="DebugView.TxtOutput"
                     Text="{Binding OutputText, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="Transparent"
                     Foreground="#CCCCCC"
                     CaretBrush="#FFFFFF"
                     BorderThickness="0"
                     FontFamily="Cascadia Mono, Consolas, Courier New"
                     FontSize="12"
                     TextChanged="OnOutputTextChanged" />
        </Border>

        <!-- 底部命令行输入与交互控制区 -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 输入框与发送/中断组 -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" x:Name="CommandInputBox"
                             AutomationProperties.AutomationId="DebugView.InputBox"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#3F3F46"
                             Padding="6,4" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             KeyDown="OnCommandInputKeyDown" />

                    <Button Grid.Column="1" Content="发送 (Enter)" Command="{Binding SendCommand}"
                            AutomationProperties.AutomationId="DebugView.BtnSend"
                            Width="85" Height="26" Margin="6,0,0,0"
                            Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />

                    <Button Grid.Column="2" Content="中断 (Ctrl+C)" Command="{Binding InterruptCommand}"
                            AutomationProperties.AutomationId="DebugView.BtnInterrupt"
                            Width="95" Height="26" Margin="6,0,0,0"
                            Background="#5A1010" Foreground="#FFAAAA" BorderThickness="0" FontWeight="SemiBold" />
                </Grid>

                <!-- 视口行列调整栏 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="调整尺寸 (列x行):" Foreground="#858585" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                    <TextBox Text="{Binding Columns, UpdateSourceTrigger=PropertyChanged}" 
                             AutomationProperties.AutomationId="DebugView.TxtColumns"
                             Width="45" Height="22" 
                             Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#3F3F46" HorizontalContentAlignment="Center" FontSize="11" />
                    <TextBlock Text=" x " Foreground="#858585" VerticalAlignment="Center" FontSize="11" />
                    <TextBox Text="{Binding Rows, UpdateSourceTrigger=PropertyChanged}" 
                             AutomationProperties.AutomationId="DebugView.TxtRows"
                             Width="45" Height="22" 
                             Background="#1E1E1E" Foreground="#FFFFFF" BorderBrush="#3F3F46" HorizontalContentAlignment="Center" FontSize="11" Margin="0,0,6,0" />
                    <Button Content="应用尺寸" Command="{Binding ResizeCommand}" 
                            AutomationProperties.AutomationId="DebugView.BtnApplyResize"
                            Width="70" Height="22"
                            Background="#333337" Foreground="#CCCCCC" BorderBrush="#555555" FontSize="11" />
                    <TextBlock Text="*注：当前为 Phase 1 调试输出模式，输入普通回车执行命令" Foreground="#666666" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="10" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
