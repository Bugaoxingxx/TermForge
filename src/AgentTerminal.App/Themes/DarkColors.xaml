<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- Windows 11 Fluent 深色语义色彩 Token 与画刷体系 (Dark Colors)        -->
    <!-- 对应系统深色模式与 ThemeMode=System 激活状态下的画刷定义             -->
    <!-- ================================================================= -->

    <!-- Fluent 原生与强调色画刷 (深色模式) -->
    <SolidColorBrush x:Key="FluentAccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="FluentWindowBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="FluentSubtleBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="FluentCardBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="FluentTextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FluentTextSecondaryBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="FluentBorderBrush" Color="#383838" />

    <!-- 主窗口外壳画刷 (Fluent Mica 材质下主窗体透明，回退时使用纯色深灰) -->
    <SolidColorBrush x:Key="AeroGlassBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AeroActiveGlassBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="AeroInactiveGlassBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AeroGlassSheenBrush" Color="Transparent" />

    <!-- 边框双线高光与外阴影画刷 (Fluent 暗色扁平微描边) -->
    <SolidColorBrush x:Key="AeroBorderHighlightBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="AeroBorderOuterBrush" Color="#40000000" />
    <SolidColorBrush x:Key="AeroBorderInnerGlowBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AeroBorderEdgeBrush" Color="#383838" />
    <SolidColorBrush x:Key="AeroBorderDarkEdgeBrush" Color="#484848" />

    <!-- 菜单栏与工具栏 (Fluent 柔和微亮半透明层，透显底层 Mica) -->
    <SolidColorBrush x:Key="AeroMenuBarBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="AeroToolBarBrush" Color="#10FFFFFF" />

    <!-- 状态栏 Fluent 扁平底色 (深色模式) -->
    <SolidColorBrush x:Key="AeroStatusBarBrush" Color="#202020" />

    <!-- MMC 工作区背景与面板画刷 (深色锻造台) -->
    <SolidColorBrush x:Key="AeroWorkspaceBackgroundBrush" Color="#181818" />
    <SolidColorBrush x:Key="AeroPanelBackgroundBrush" Color="#252525" />
    <SolidColorBrush x:Key="AeroPropertiesBackgroundBrush" Color="#252525" />
    <SolidColorBrush x:Key="AeroDiagnosticsBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="AeroSplitterBrush" Color="#383838" />
    <SolidColorBrush x:Key="AeroSplitterGripBrush" Color="#6E6E6E" />

    <!-- 文字前景色画刷 (深色模式排版对比度) -->
    <SolidColorBrush x:Key="AeroTextDarkBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="AeroTextNormalBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AeroTextMutedBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="AeroTextInactiveTitleBrush" Color="#707070" />
    <SolidColorBrush x:Key="AeroTextSuccessBrush" Color="#54B054" />
    <SolidColorBrush x:Key="AeroTextDangerBrush" Color="#FF6B6B" />

    <!-- Fluent 窗口控制按钮画刷 (暗色自适应) -->
    <SolidColorBrush x:Key="AeroCapButtonBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AeroCapButtonHoverBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="AeroCapButtonPressedBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="AeroCloseButtonBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AeroCloseButtonHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="AeroCloseButtonPressedBrush" Color="#A82315" />

    <!-- 语义状态画刷 (深色模式焦点与选区) -->
    <SolidColorBrush x:Key="AeroFocusBorderBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="AeroSelectionHighlightBrush" Color="#264F78" />
    <SolidColorBrush x:Key="AeroSelectionTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AeroInactiveSelectionHighlightBrush" Color="#333333" />
    <SolidColorBrush x:Key="AeroInactiveSelectionTextBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="AeroDisabledForegroundBrush" Color="#666666" />
    <SolidColorBrush x:Key="AeroDangerBorderBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="AeroDangerBackgroundBrush" Color="#3B1A1A" />

    <!-- 滤镜与特效 -->
    <DropShadowEffect x:Key="AeroTitleGlowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <DropShadowEffect x:Key="AeroInactiveTitleGlowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <DropShadowEffect x:Key="AeroWindowShadowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <DropShadowEffect x:Key="AeroMdiChildShadowEffect" Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.5" />

</ResourceDictionary>
