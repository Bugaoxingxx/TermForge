<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- 高对比度系统颜色适配字典 (High Contrast System Color Fallbacks)    -->
    <!-- 遵循 WCAG 2.1 AA 与 Windows 高对比度辅助功能规范                      -->
    <!-- ================================================================= -->

    <!-- Fluent 语义 Token 高对比度映射 -->
    <SolidColorBrush x:Key="FluentAccentBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="FluentWindowBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="FluentSubtleBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="FluentCardBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="FluentTextPrimaryBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="FluentTextSecondaryBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="FluentBorderBrush" Color="{x:Static SystemColors.WindowFrameColor}" />

    <!-- 主窗口与 MDI 标题栏画刷 -->
    <SolidColorBrush x:Key="AeroGlassBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="AeroActiveGlassBrush" Color="{x:Static SystemColors.ActiveCaptionColor}" />
    <SolidColorBrush x:Key="AeroInactiveGlassBrush" Color="{x:Static SystemColors.InactiveCaptionColor}" />
    <SolidColorBrush x:Key="AeroGlassSheenBrush" Color="Transparent" />

    <!-- 边框与分割条 -->
    <SolidColorBrush x:Key="AeroBorderHighlightBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AeroBorderOuterBrush" Color="{x:Static SystemColors.WindowFrameColor}" />
    <SolidColorBrush x:Key="AeroBorderInnerGlowBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AeroBorderEdgeBrush" Color="{x:Static SystemColors.ActiveBorderColor}" />
    <SolidColorBrush x:Key="AeroBorderDarkEdgeBrush" Color="{x:Static SystemColors.WindowFrameColor}" />

    <!-- 菜单、工具栏、状态栏画刷 -->
    <SolidColorBrush x:Key="AeroMenuBarBrush" Color="{x:Static SystemColors.MenuBarColor}" />
    <SolidColorBrush x:Key="AeroToolBarBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AeroStatusBarBrush" Color="{x:Static SystemColors.ControlColor}" />

    <!-- 工作区与面板画刷 -->
    <SolidColorBrush x:Key="AeroWorkspaceBackgroundBrush" Color="{x:Static SystemColors.AppWorkspaceColor}" />
    <SolidColorBrush x:Key="AeroPanelBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="AeroPropertiesBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="AeroDiagnosticsBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="AeroSplitterBrush" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="AeroSplitterGripBrush" Color="{x:Static SystemColors.ControlTextColor}" />

    <!-- 文字前景色 (成功与危险使用不同系统色及非颜色辅助提示) -->
    <SolidColorBrush x:Key="AeroTextDarkBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AeroTextNormalBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="AeroTextMutedBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="AeroTextInactiveTitleBrush" Color="{x:Static SystemColors.InactiveCaptionTextColor}" />
    <SolidColorBrush x:Key="AeroTextSuccessBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AeroTextDangerBrush" Color="{x:Static SystemColors.HotTrackColor}" />

    <!-- 窗口控制按钮 -->
    <SolidColorBrush x:Key="AeroCapButtonBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AeroCapButtonHoverBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AeroCapButtonPressedBrush" Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="AeroCloseButtonBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AeroCloseButtonHoverBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AeroCloseButtonPressedBrush" Color="{x:Static SystemColors.HotTrackColor}" />

    <!-- 语义状态与选择 -->
    <SolidColorBrush x:Key="AeroFocusBorderBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AeroSelectionHighlightBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AeroSelectionTextBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="AeroInactiveSelectionHighlightBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AeroInactiveSelectionTextBrush" Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="AeroDisabledForegroundBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="AeroDangerBorderBrush" Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="AeroDangerBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />

    <!-- 阴影与光晕特效 (高对比度模式下全面关闭虚化与阴影) -->
    <DropShadowEffect x:Key="AeroTitleGlowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <DropShadowEffect x:Key="AeroInactiveTitleGlowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <DropShadowEffect x:Key="AeroWindowShadowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <DropShadowEffect x:Key="AeroMdiChildShadowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" />

    <!-- MDI 子窗口高对比度适配 -->
    <SolidColorBrush x:Key="MdiActiveGlassBrush" Color="{x:Static SystemColors.ActiveCaptionColor}" />
    <SolidColorBrush x:Key="MdiInactiveGlassBrush" Color="{x:Static SystemColors.InactiveCaptionColor}" />
    <SolidColorBrush x:Key="MdiSheenBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MdiActiveBorderBrush" Color="{x:Static SystemColors.ActiveBorderColor}" />
    <SolidColorBrush x:Key="MdiInactiveBorderBrush" Color="{x:Static SystemColors.InactiveBorderColor}" />
    <SolidColorBrush x:Key="MdiHeaderSeparatorBrush" Color="{x:Static SystemColors.WindowFrameColor}" />
    <SolidColorBrush x:Key="MdiViewportBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="MdiWorkspaceBackgroundBrush" Color="{x:Static SystemColors.AppWorkspaceColor}" />
    <SolidColorBrush x:Key="MdiTrayBackgroundBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="MdiTrayBorderBrush" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="MdiTaskButtonBackgroundBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="MdiTaskButtonBorderBrush" Color="{x:Static SystemColors.ControlDarkColor}" />

    <DropShadowEffect x:Key="MdiTitleGlowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <DropShadowEffect x:Key="MdiInactiveTitleGlowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <DropShadowEffect x:Key="MdiActiveShadowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <DropShadowEffect x:Key="MdiInactiveShadowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" />

</ResourceDictionary>
