<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- 1. Windows 7 Aero 核心色彩与画刷 (Colors & Brushes)               -->
    <!-- ================================================================= -->

    <!-- 主窗口 Aero 天青毛玻璃画刷 -->
    <LinearGradientBrush x:Key="AeroGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C0B8DCF5" Offset="0.0" />
        <GradientStop Color="#9085BCE8" Offset="0.4" />
        <GradientStop Color="#8570AEE0" Offset="0.5" />
        <GradientStop Color="#A099D0F0" Offset="1.0" />
    </LinearGradientBrush>

    <!-- MDI 活动子窗口 Aero 玻璃画刷 -->
    <LinearGradientBrush x:Key="AeroActiveGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D0D5EEFB" Offset="0.0" />
        <GradientStop Color="#B0A0D2F4" Offset="0.45" />
        <GradientStop Color="#988CC5EB" Offset="0.5" />
        <GradientStop Color="#B8B0DEFA" Offset="1.0" />
    </LinearGradientBrush>

    <!-- MDI 非活动子窗口 Aero 浅灰蓝玻璃画刷 -->
    <LinearGradientBrush x:Key="AeroInactiveGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B8E3E9EE" Offset="0.0" />
        <GradientStop Color="#90C5D0D9" Offset="0.45" />
        <GradientStop Color="#85B2BDC8" Offset="0.5" />
        <GradientStop Color="#A5CFD7DE" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Aero 顶部半月形反光层 (Sheen) -->
    <LinearGradientBrush x:Key="AeroGlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D0FFFFFF" Offset="0.0" />
        <GradientStop Color="#50FFFFFF" Offset="0.45" />
        <GradientStop Color="#00FFFFFF" Offset="0.50" />
        <GradientStop Color="#30FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 边框双线高光与外阴影画刷 -->
    <SolidColorBrush x:Key="AeroBorderHighlightBrush" Color="#E8FFFFFF" />
    <SolidColorBrush x:Key="AeroBorderOuterBrush" Color="#501A3654" />
    <SolidColorBrush x:Key="AeroBorderInnerGlowBrush" Color="#80FFFFFF" />

    <!-- 菜单栏与工具栏 Explorer 经典淡蓝渐变画刷 -->
    <LinearGradientBrush x:Key="AeroMenuBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFBFC" Offset="0.0" />
        <GradientStop Color="#ECEFF4" Offset="0.6" />
        <GradientStop Color="#E2E6ED" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AeroToolBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0.0" />
        <GradientStop Color="#F3F6FA" Offset="0.4" />
        <GradientStop Color="#E4E9F2" Offset="0.5" />
        <GradientStop Color="#D8DFEC" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 状态栏经典银灰渐变画刷 -->
    <LinearGradientBrush x:Key="AeroStatusBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6EBF2" Offset="0.0" />
        <GradientStop Color="#D5DBE5" Offset="0.5" />
        <GradientStop Color="#C5CDD9" Offset="0.51" />
        <GradientStop Color="#DAE0EA" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Win7 窗口控制按钮画刷 -->
    <!-- 最小化/最大化常规画刷 -->
    <LinearGradientBrush x:Key="AeroCapButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#60FFFFFF" Offset="0.0" />
        <GradientStop Color="#25D0E8FC" Offset="0.5" />
        <GradientStop Color="#35A0D0F5" Offset="0.51" />
        <GradientStop Color="#60E0F0FE" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 最小化/最大化悬浮水蓝发光画刷 -->
    <LinearGradientBrush x:Key="AeroCapButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B0FFFFFF" Offset="0.0" />
        <GradientStop Color="#70B0E4FE" Offset="0.5" />
        <GradientStop Color="#8572C4F8" Offset="0.51" />
        <GradientStop Color="#A0C8EEFE" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 红宝石关闭按钮常态画刷 -->
    <LinearGradientBrush x:Key="AeroCloseButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D0F3B0A4" Offset="0.0" />
        <GradientStop Color="#B5DE6656" Offset="0.48" />
        <GradientStop Color="#D5C51E14" Offset="0.52" />
        <GradientStop Color="#E5E45244" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 红宝石关闭按钮悬停炽红画刷 -->
    <LinearGradientBrush x:Key="AeroCloseButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFA698" Offset="0.0" />
        <GradientStop Color="#F0F05847" Offset="0.48" />
        <GradientStop Color="#FFD8180E" Offset="0.52" />
        <GradientStop Color="#FFFF6052" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ================================================================= -->
    <!-- 2. 特效与滤镜 (Effects)                                            -->
    <!-- ================================================================= -->

    <!-- 标题文字发光光晕 (Title Halo Glow) -->
    <DropShadowEffect x:Key="AeroTitleGlowEffect"
                      Color="#FFFFFF"
                      BlurRadius="10"
                      ShadowDepth="0"
                      Opacity="0.95" />

    <!-- 非活动标题柔和光晕 -->
    <DropShadowEffect x:Key="AeroInactiveTitleGlowEffect"
                      Color="#FFFFFF"
                      BlurRadius="6"
                      ShadowDepth="0"
                      Opacity="0.8" />

    <!-- 主窗口外阴影 -->
    <DropShadowEffect x:Key="AeroWindowShadowEffect"
                      Color="#000000"
                      BlurRadius="20"
                      ShadowDepth="4"
                      Opacity="0.5" />

    <!-- MDI 子窗口外阴影 -->
    <DropShadowEffect x:Key="AeroMdiChildShadowEffect"
                      Color="#000000"
                      BlurRadius="14"
                      ShadowDepth="3"
                      Opacity="0.45" />

    <!-- ================================================================= -->
    <!-- 3. 控件样式 (Control Styles)                                      -->
    <!-- ================================================================= -->

    <!-- Aero 标题文字样式 -->
    <Style x:Key="AeroTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Microsoft YaHei" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#0C1A26" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{StaticResource AeroTitleGlowEffect}" />
    </Style>

    <Style x:Key="AeroInactiveTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Microsoft YaHei" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#4A5C6D" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{StaticResource AeroInactiveTitleGlowEffect}" />
    </Style>

    <!-- Aero 胶囊式工具栏按钮 -->
    <Style x:Key="AeroToolBarButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#9FB4CC" />
        <Setter Property="Foreground" Value="#1E395B" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="3"
                            Background="#EBF2FA"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F2F8FE" Offset="0.0" />
                                        <GradientStop Color="#D5E8F9" Offset="0.48" />
                                        <GradientStop Color="#B5D7F5" Offset="0.52" />
                                        <GradientStop Color="#D7EBFB" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#5C8FC2" />
                            <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#0090FF" BlurRadius="5" ShadowDepth="0" Opacity="0.4" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#C7DFF3" Offset="0.0" />
                                        <GradientStop Color="#A8CCED" Offset="0.5" />
                                        <GradientStop Color="#8DBBE5" Offset="0.52" />
                                        <GradientStop Color="#BFE0F8" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#386A9E" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aero 金属蚀刻工具栏分割线 -->
    <Style x:Key="AeroToolBarSeparatorStyle" TargetType="Separator">
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Width" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Grid Width="2" HorizontalAlignment="Center">
                        <Line X1="0" Y1="0" X2="0" Y2="18" Stroke="#B6BEC8" StrokeThickness="1" />
                        <Line X1="1" Y1="0" X2="1" Y2="18" Stroke="#FFFFFF" StrokeThickness="1" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aero 最小化/最大化通用玻璃控制按钮 -->
    <Style x:Key="AeroCaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="29" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Background" Value="{StaticResource AeroCapButtonBrush}" />
        <Setter Property="BorderBrush" Value="#80FFFFFF" />
        <Setter Property="BorderThickness" Value="1,0,1,1" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="0,0,2,2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AeroCapButtonHoverBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="#8000B4FF" />
                            <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00B4FF" BlurRadius="8" ShadowDepth="0" Opacity="0.75" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#8CDBFC" Offset="0.0" />
                                        <GradientStop Color="#5CAAE0" Offset="0.5" />
                                        <GradientStop Color="#4290CC" Offset="0.52" />
                                        <GradientStop Color="#85C4F0" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aero 红宝石关闭按钮 -->
    <Style x:Key="AeroCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Background" Value="{StaticResource AeroCloseButtonBrush}" />
        <Setter Property="BorderBrush" Value="#80B43C3C" />
        <Setter Property="BorderThickness" Value="1,0,1,1" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="0,0,4,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AeroCloseButtonHoverBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="#A01005" />
                            <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF3228" BlurRadius="10" ShadowDepth="0" Opacity="0.95" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#99160D" Offset="0.0" />
                                        <GradientStop Color="#D42213" Offset="0.5" />
                                        <GradientStop Color="#B0180C" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aero 经典 Explorer 树节点样式 -->
    <Style x:Key="AeroTreeViewItemStyle" TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="#2B3D52" />
        <Setter Property="FontFamily" Value="Segoe UI, Tahoma" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="3,2" />
        <Style.Resources>
            <!-- 覆盖默认高亮颜色为 Win7 天蓝高光条 -->
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CDE5FA" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0B2240" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E4EFF8" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#2B3D52" />
        </Style.Resources>
    </Style>

</ResourceDictionary>
