<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- 1. Windows 11 Fluent 语义色彩 Token 与画刷体系 (Fluent Tokens)       -->
    <!-- 映射系统强调色与深浅语义，同时保留原有 Aero 键以实现向后无感兼容       -->
    <!-- ================================================================= -->

    <!-- Fluent 原生与强调色画刷 -->
    <SolidColorBrush x:Key="FluentAccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="FluentWindowBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="FluentSubtleBrush" Color="#08000000" />
    <SolidColorBrush x:Key="FluentCardBackgroundBrush" Color="#FBFBFB" />
    <SolidColorBrush x:Key="FluentTextPrimaryBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="FluentTextSecondaryBrush" Color="#616161" />
    <SolidColorBrush x:Key="FluentBorderBrush" Color="#E5E5E5" />

    <!-- 主窗口外壳画刷 (Fluent Mica 材质下主窗体透明，回退时使用纯色) -->
    <SolidColorBrush x:Key="AeroGlassBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AeroActiveGlassBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="AeroInactiveGlassBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AeroGlassSheenBrush" Color="Transparent" />

    <!-- 边框双线高光与外阴影画刷 (Fluent 扁平微描边) -->
    <SolidColorBrush x:Key="AeroBorderHighlightBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="AeroBorderOuterBrush" Color="#20000000" />
    <SolidColorBrush x:Key="AeroBorderInnerGlowBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AeroBorderEdgeBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="AeroBorderDarkEdgeBrush" Color="#D1D1D1" />

    <!-- 菜单栏与工具栏 (Fluent 柔和半透明层，透显底层 Mica) -->
    <SolidColorBrush x:Key="AeroMenuBarBrush" Color="#05000000" />
    <SolidColorBrush x:Key="AeroToolBarBrush" Color="#05000000" />

    <!-- 状态栏 Fluent 扁平底色 -->
    <SolidColorBrush x:Key="AeroStatusBarBrush" Color="#F3F3F3" />

    <!-- MMC 工作区背景与面板画刷 (终端视口严格保留为深色锻造台) -->
    <SolidColorBrush x:Key="AeroWorkspaceBackgroundBrush" Color="#1B2631" />
    <SolidColorBrush x:Key="AeroPanelBackgroundBrush" Color="#F9F9F9" />
    <SolidColorBrush x:Key="AeroPropertiesBackgroundBrush" Color="#F8F8F8" />
    <SolidColorBrush x:Key="AeroDiagnosticsBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AeroSplitterBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="AeroSplitterGripBrush" Color="#9E9E9E" />

    <!-- 文字前景色画刷 (遵循 Fluent 排版对比度规范) -->
    <SolidColorBrush x:Key="AeroTextDarkBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="AeroTextNormalBrush" Color="#242424" />
    <SolidColorBrush x:Key="AeroTextMutedBrush" Color="#616161" />
    <SolidColorBrush x:Key="AeroTextInactiveTitleBrush" Color="#8C8C8C" />
    <SolidColorBrush x:Key="AeroTextSuccessBrush" Color="#107C41" />
    <SolidColorBrush x:Key="AeroTextDangerBrush" Color="#C42B1C" />

    <!-- Fluent 窗口控制按钮画刷 (透明常态，悬停半透明深浅自适应，关闭按钮悬停亮红) -->
    <SolidColorBrush x:Key="AeroCapButtonBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AeroCapButtonHoverBrush" Color="#12000000" />
    <SolidColorBrush x:Key="AeroCapButtonPressedBrush" Color="#1E000000" />
    <SolidColorBrush x:Key="AeroCloseButtonBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AeroCloseButtonHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="AeroCloseButtonPressedBrush" Color="#A82315" />

    <!-- 语义状态画刷 (绑定系统高亮/焦点) -->
    <SolidColorBrush x:Key="AeroFocusBorderBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AeroSelectionHighlightBrush" Color="#D9E7F6" />
    <SolidColorBrush x:Key="AeroSelectionTextBrush" Color="#0B2240" />
    <SolidColorBrush x:Key="AeroInactiveSelectionHighlightBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="AeroInactiveSelectionTextBrush" Color="#424242" />
    <SolidColorBrush x:Key="AeroDisabledForegroundBrush" Color="#9E9E9E" />
    <SolidColorBrush x:Key="AeroDangerBorderBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="AeroDangerBackgroundBrush" Color="#FDF2F2" />

    <!-- 滤镜与特效 (Fluent 外壳去除拟物文字发光，系统阴影由 DWM 接管) -->
    <DropShadowEffect x:Key="AeroTitleGlowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <DropShadowEffect x:Key="AeroInactiveTitleGlowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <DropShadowEffect x:Key="AeroWindowShadowEffect" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <DropShadowEffect x:Key="AeroMdiChildShadowEffect" Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.25" />

</ResourceDictionary>
