<UserControl x:Class="AgentTerminal.Docking.Controls.MdiChildWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:AgentTerminal.Core.Models;assembly=AgentTerminal.Core"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400"
             AutomationProperties.AutomationId="MdiChildWindow"
             AutomationProperties.Name="{Binding Title}"
             PreviewMouseDown="OnPreviewMouseDown">

    <UserControl.Resources>
        <!-- 活动窗口 Aero 玻璃画刷 -->
        <LinearGradientBrush x:Key="LocalActiveGlassBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E8F1FA" Offset="0.0" />
            <GradientStop Color="#C2E0F8" Offset="0.45" />
            <GradientStop Color="#9BC7EE" Offset="0.5" />
            <GradientStop Color="#CCE5FA" Offset="1.0" />
        </LinearGradientBrush>

        <!-- 非活动窗口 Aero 玻璃画刷 -->
        <LinearGradientBrush x:Key="LocalInactiveGlassBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EDF2F7" Offset="0.0" />
            <GradientStop Color="#D2DCE6" Offset="0.45" />
            <GradientStop Color="#BAC6D2" Offset="0.5" />
            <GradientStop Color="#D8E2EB" Offset="1.0" />
        </LinearGradientBrush>

        <!-- 标题栏顶部半月形反光层 -->
        <LinearGradientBrush x:Key="LocalSheenBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C0FFFFFF" Offset="0.0" />
            <GradientStop Color="#40FFFFFF" Offset="0.5" />
            <GradientStop Color="#00FFFFFF" Offset="0.52" />
            <GradientStop Color="#25FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <!-- 标题文字发光特效 -->
        <DropShadowEffect x:Key="LocalTitleGlow" Color="#FFFFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.95" />
        <DropShadowEffect x:Key="LocalInactiveTitleGlow" Color="#FFFFFF" BlurRadius="4" ShadowDepth="0" Opacity="0.75" />
    </UserControl.Resources>

    <Grid>
        <!-- 窗口主容器 (Windows 7 Aero 外边框) -->
        <Border x:Name="WindowBorder"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#805C7E9C" />
                    <Setter Property="Background" Value="#0C0F14" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="BorderBrush" Value="#902672B5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.45" Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" /> <!-- Aero 经典高度标题栏 -->
                    <RowDefinition Height="*" />  <!-- 终端文档内容区 -->
                </Grid.RowDefinitions>

                <!-- Aero 标题栏外壳 -->
                <Grid Grid.Row="0" x:Name="TitleBar" 
                      AutomationProperties.AutomationId="MdiWindow.TitleBar"
                      MouseLeftButtonDown="OnTitleBarMouseDown"
                      MouseMove="OnTitleBarMouseMove"
                      MouseLeftButtonUp="OnTitleBarMouseUp"
                      LostMouseCapture="OnTitleBarLostMouseCapture">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Background" Value="{StaticResource LocalInactiveGlassBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource LocalActiveGlassBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 顶部高光反射条 (Sheen) -->
                    <Border Grid.ColumnSpan="3" Height="14" VerticalAlignment="Top" Background="{StaticResource LocalSheenBrush}" IsHitTestVisible="False" />
                    <!-- 底部分割线，与黑色终端内容产生清晰界线 -->
                    <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Background="#601A3654" IsHitTestVisible="False" />

                    <!-- 图标与标题 -->
                    <Border Grid.Column="0" Margin="6,0,4,0" VerticalAlignment="Center" Width="16" Height="16"
                            CornerRadius="2" Background="#1E395B" BorderBrush="#80FFFFFF" BorderThickness="1" IsHitTestVisible="False">
                        <TextBlock Text=">_" Foreground="#4EC9B0" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Column="1" Margin="4,0,8,0" Text="{Binding Title}"
                               AutomationProperties.AutomationId="MdiWindow.Title"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontFamily="Segoe UI, Tahoma, Microsoft YaHei" FontSize="11" FontWeight="Bold"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#3A4D60" />
                                <Setter Property="Effect" Value="{StaticResource LocalInactiveTitleGlow}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Foreground" Value="#0A1826" />
                                        <Setter Property="Effect" Value="{StaticResource LocalTitleGlow}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 窗口控制按钮组：最小化、最大化/还原、红宝石关闭 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,2,0">
                        <!-- 最小化按钮 -->
                        <Button Width="26" Height="18" Margin="0,0,1,0"
                                Command="{Binding MinimizeCommand}" ToolTip="最小化"
                                AutomationProperties.AutomationId="MdiWindow.BtnMinimize"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="0,0,2,2" BorderThickness="1,0,1,1"
                                            BorderBrush="#60FFFFFF" Background="#30FFFFFF">
                                        <Rectangle Width="8" Height="2" Fill="#1E395B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#90C8EEFE" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#8000B4FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 最大化/还原按钮 -->
                        <Button Width="26" Height="18" Margin="0,0,1,0"
                                Click="OnMaximizeRestoreClicked" ToolTip="最大化/还原"
                                AutomationProperties.AutomationId="MdiWindow.BtnMaxRestore"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="0,0,2,2" BorderThickness="1,0,1,1"
                                            BorderBrush="#60FFFFFF" Background="#30FFFFFF">
                                        <TextBlock Text="{Binding WindowState, ConverterParameter='buttonText', RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   x:Name="MaxRestoreText" FontSize="10" FontWeight="Bold" Foreground="#1E395B"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="□" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WindowState}" Value="{x:Static models:MdiWindowState.Maximized}">
                                                            <Setter Property="Text" Value="❐" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#90C8EEFE" />
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#8000B4FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 红宝石关闭按钮 (Win7 标志性果冻红) -->
                        <Button Width="38" Height="18"
                                Command="{Binding CloseCommand}" ToolTip="关闭"
                                AutomationProperties.AutomationId="MdiWindow.BtnClose"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="0,0,3,0" BorderThickness="1,0,1,1"
                                            BorderBrush="#70B03020">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#D8F3B0A4" Offset="0.0" />
                                                <GradientStop Color="#B5DE6656" Offset="0.48" />
                                                <GradientStop Color="#D5C51E14" Offset="0.52" />
                                                <GradientStop Color="#E5E45244" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="✕" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFFFA698" Offset="0.0" />
                                                        <GradientStop Color="#F0F05847" Offset="0.48" />
                                                        <GradientStop Color="#FFD8180E" Offset="0.52" />
                                                        <GradientStop Color="#FFFF6052" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#A01005" />
                                            <Setter TargetName="bd" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#FF3228" BlurRadius="8" ShadowDepth="0" Opacity="0.95" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#99160D" Offset="0.0" />
                                                        <GradientStop Color="#D42213" Offset="0.5" />
                                                        <GradientStop Color="#B0180C" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 内容区 (深空黑色终端视口) -->
                <ContentPresenter Grid.Row="1" Content="{Binding}" />
            </Grid>
        </Border>

        <!-- 8 向拉伸手柄 (仅在 Normal 状态生效) -->
        <Grid x:Name="ResizeGrid">
            <Thumb AutomationProperties.AutomationId="MdiWindow.Thumb.TopLeft" Cursor="SizeNWSE" HorizontalAlignment="Left" VerticalAlignment="Top" Width="7" Height="7" DragDelta="OnResizeTopLeft" Opacity="0" />
            <Thumb AutomationProperties.AutomationId="MdiWindow.Thumb.TopRight" Cursor="SizeNESW" HorizontalAlignment="Right" VerticalAlignment="Top" Width="7" Height="7" DragDelta="OnResizeTopRight" Opacity="0" />
            <Thumb AutomationProperties.AutomationId="MdiWindow.Thumb.BottomLeft" Cursor="SizeNESW" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="7" Height="7" DragDelta="OnResizeBottomLeft" Opacity="0" />
            <Thumb AutomationProperties.AutomationId="MdiWindow.Thumb.BottomRight" Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="7" Height="7" DragDelta="OnResizeBottomRight" Opacity="0" />

            <Thumb AutomationProperties.AutomationId="MdiWindow.Thumb.Top" Cursor="SizeNS" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="5" Margin="7,0,7,0" DragDelta="OnResizeTop" Opacity="0" />
            <Thumb AutomationProperties.AutomationId="MdiWindow.Thumb.Bottom" Cursor="SizeNS" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="5" Margin="7,0,7,0" DragDelta="OnResizeBottom" Opacity="0" />
            <Thumb AutomationProperties.AutomationId="MdiWindow.Thumb.Left" Cursor="SizeWE" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="5" Margin="0,7,0,7" DragDelta="OnResizeLeft" Opacity="0" />
            <Thumb AutomationProperties.AutomationId="MdiWindow.Thumb.Right" Cursor="SizeWE" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="5" Margin="0,7,0,7" DragDelta="OnResizeRight" Opacity="0" />
        </Grid>
    </Grid>
</UserControl>
