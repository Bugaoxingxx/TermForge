<UserControl x:Class="AgentTerminal.Docking.Controls.MdiChildWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:AgentTerminal.Core.Models;assembly=AgentTerminal.Core"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400"
             AutomationProperties.AutomationId="MdiChildWindow"
             AutomationProperties.Name="{Binding Title}"
             PreviewMouseDown="OnPreviewMouseDown">
    
    <Grid>
        <!-- 窗口主容器 -->
        <Border x:Name="WindowBorder"
                BorderThickness="1"
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                CornerRadius="3"
                ClipToBounds="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#7F7F7F" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="BorderBrush" Value="#0078D7" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Direction="270" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" /> <!-- 标题栏 -->
                    <RowDefinition Height="*" />  <!-- 文档内容区 -->
                </Grid.RowDefinitions>

                <!-- MMC 经典标题栏 -->
                <Grid Grid.Row="0" x:Name="TitleBar" 
                      MouseLeftButtonDown="OnTitleBarMouseDown"
                      MouseMove="OnTitleBarMouseMove"
                      MouseLeftButtonUp="OnTitleBarMouseUp"
                      LostMouseCapture="OnTitleBarLostMouseCapture">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Background" Value="#3F3F46" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background" Value="#005A9E" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 图标与标题 -->
                    <TextBlock Grid.Column="0" Margin="8,0,4,0" Text=">_" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Grid.Column="1" Margin="4,0,8,0" Text="{Binding Title}" AutomationProperties.AutomationId="MdiWindow.Title" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />

                    <!-- 窗口控制按钮组：最小化、最大化/还原、关闭 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Width="30" Height="32" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                                Command="{Binding MinimizeCommand}" ToolTip="最小化"
                                AutomationProperties.AutomationId="MdiWindow.BtnMinimize">
                            <TextBlock Text="一" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                        <Button Width="30" Height="32" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                                Click="OnMaximizeRestoreClicked" ToolTip="最大化/还原"
                                AutomationProperties.AutomationId="MdiWindow.BtnMaxRestore">
                            <TextBlock Text="{Binding WindowState, ConverterParameter='buttonText', RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                       x:Name="MaxRestoreText" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="□" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState}" Value="{x:Static models:MdiWindowState.Maximized}">
                                                <Setter Property="Text" Value="❐" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Width="32" Height="32" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                                Command="{Binding CloseCommand}" ToolTip="关闭"
                                AutomationProperties.AutomationId="MdiWindow.BtnClose">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E81123" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="✕" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 内容区 -->
                <ContentPresenter Grid.Row="1" Content="{Binding}" />
            </Grid>
        </Border>

        <!-- 8 向拉伸手柄 (仅在 Normal 状态生效) -->
        <Grid x:Name="ResizeGrid">
            <Thumb Cursor="SizeNWSE" HorizontalAlignment="Left" VerticalAlignment="Top" Width="7" Height="7" DragDelta="OnResizeTopLeft" Opacity="0" />
            <Thumb Cursor="SizeNESW" HorizontalAlignment="Right" VerticalAlignment="Top" Width="7" Height="7" DragDelta="OnResizeTopRight" Opacity="0" />
            <Thumb Cursor="SizeNESW" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="7" Height="7" DragDelta="OnResizeBottomLeft" Opacity="0" />
            <Thumb Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="7" Height="7" DragDelta="OnResizeBottomRight" Opacity="0" />

            <Thumb Cursor="SizeNS" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="5" Margin="7,0,7,0" DragDelta="OnResizeTop" Opacity="0" />
            <Thumb Cursor="SizeNS" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="5" Margin="7,0,7,0" DragDelta="OnResizeBottom" Opacity="0" />
            <Thumb Cursor="SizeWE" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="5" Margin="0,7,0,7" DragDelta="OnResizeLeft" Opacity="0" />
            <Thumb Cursor="SizeWE" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="5" Margin="0,7,0,7" DragDelta="OnResizeRight" Opacity="0" />
        </Grid>
    </Grid>
</UserControl>
