<UserControl x:Class="AgentTerminal.Docking.Controls.MdiContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AgentTerminal.Docking.Controls"
             xmlns:models="clr-namespace:AgentTerminal.Core.Models;assembly=AgentTerminal.Core"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             SizeChanged="OnContainerSizeChanged">
    
    <Grid Background="{DynamicResource MdiWorkspaceBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 主工作区 Canvas：承载所有 Normal 和 Maximized 子窗口，低噪蓝灰 MDI 工作区背景 -->
        <ItemsControl Grid.Row="0" x:Name="MdiItemsControl" AutomationProperties.AutomationId="Workbench.MdiCanvasArea">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas x:Name="MdiCanvas" ClipToBounds="True" Background="{DynamicResource MdiWorkspaceBackgroundBrush}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Left, Mode=TwoWay}" />
                    <Setter Property="Canvas.Top" Value="{Binding Top, Mode=TwoWay}" />
                    <Setter Property="Panel.ZIndex" Value="{Binding ZIndex, Mode=TwoWay}" />
                    <Setter Property="Width" Value="{Binding Width, Mode=TwoWay}" />
                    <Setter Property="Height" Value="{Binding Height, Mode=TwoWay}" />
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <!-- 最小化时在 Canvas 中隐藏 -->
                        <DataTrigger Binding="{Binding WindowState}" Value="{x:Static models:MdiWindowState.Minimized}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- 最大化时填满视口 -->
                        <DataTrigger Binding="{Binding WindowState}" Value="{x:Static models:MdiWindowState.Maximized}">
                            <Setter Property="Canvas.Left" Value="0" />
                            <Setter Property="Canvas.Top" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:MdiChildWindow />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 底部最小化窗口托盘区 (Windows 7 Aero 浅色任务按钮托盘) -->
        <Border Grid.Row="1" x:Name="MinimizedTray"
                AutomationProperties.AutomationId="Workbench.MinimizedTray"
                Background="{DynamicResource MdiTrayBackgroundBrush}"
                BorderBrush="{DynamicResource MdiTrayBorderBrush}"
                BorderThickness="0,1,0,0" Padding="6,4">
            <ItemsControl x:Name="MinimizedItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource MdiTaskButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource MdiTaskButtonBorderBrush}"
                                BorderThickness="1" CornerRadius="3" Margin="0,0,6,0" Padding="6,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 还原/激活区域 -->
                                <Button Command="{Binding RestoreCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="2,1"
                                        Cursor="Hand"
                                        ToolTip="还原窗口"
                                        AutomationProperties.AutomationId="MdiTray.BtnRestore">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1E395B" CornerRadius="2" Padding="3,1" Margin="0,0,5,0">
                                            <TextBlock Text=">_" Foreground="#4EC9B0" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#1E395B"
                                                   FontFamily="Segoe UI, Microsoft YaHei UI, Tahoma"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="140"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                                <!-- 关闭按钮 -->
                                <Button Command="{Binding CloseCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Width="16"
                                        Height="16"
                                        Margin="2,0,0,0"
                                        Padding="0"
                                        Cursor="Hand"
                                        ToolTip="关闭窗口"
                                        AutomationProperties.AutomationId="MdiTray.BtnClose">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="2">
                                                <Path x:Name="p" Data="{DynamicResource MdiCloseGeometry}"
                                                      Stroke="#708090" StrokeThickness="1.2"
                                                      Width="8" Height="8" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FFE81123" />
                                                    <Setter TargetName="p" Property="Stroke" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
