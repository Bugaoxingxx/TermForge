<UserControl x:Class="AgentTerminal.Docking.Controls.MdiContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AgentTerminal.Docking.Controls"
             xmlns:models="clr-namespace:AgentTerminal.Core.Models;assembly=AgentTerminal.Core"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             SizeChanged="OnContainerSizeChanged">
    
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 主工作区 Canvas：承载所有 Normal 和 Maximized 子窗口 -->
        <ItemsControl Grid.Row="0" x:Name="MdiItemsControl">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas x:Name="MdiCanvas" ClipToBounds="True" Background="#252526" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                    <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                    <Setter Property="Width" Value="{Binding Width}" />
                    <Setter Property="Height" Value="{Binding Height}" />
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <!-- 最小化时在 Canvas 中隐藏 -->
                        <DataTrigger Binding="{Binding WindowState}" Value="{x:Static models:MdiWindowState.Minimized}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- 最大化时填满视口 -->
                        <DataTrigger Binding="{Binding WindowState}" Value="{x:Static models:MdiWindowState.Maximized}">
                            <Setter Property="Canvas.Left" Value="0" />
                            <Setter Property="Canvas.Top" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:MdiChildWindow />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 底部最小化窗口托盘区 (Win32 MDI 风格托盘) -->
        <Border Grid.Row="1" x:Name="MinimizedTray" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="6,4">
            <ItemsControl x:Name="MinimizedItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#3E3E42" BorderBrush="#555555" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text=">_" Foreground="#4EC9B0" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" Foreground="#E0E0E0" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Button Command="{Binding RestoreCommand}" Background="Transparent" BorderThickness="0" Foreground="#CCCCCC" ToolTip="还原窗口" Margin="0,0,4,0">
                                    <TextBlock Text="❐" FontSize="11" />
                                </Button>
                                <Button Command="{Binding CloseCommand}" Background="Transparent" BorderThickness="0" Foreground="#CCCCCC" ToolTip="关闭窗口">
                                    <TextBlock Text="✕" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
