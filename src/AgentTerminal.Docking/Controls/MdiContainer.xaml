<UserControl x:Class="AgentTerminal.Docking.Controls.MdiContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AgentTerminal.Docking.Controls"
             xmlns:models="clr-namespace:AgentTerminal.Core.Models;assembly=AgentTerminal.Core"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             SizeChanged="OnContainerSizeChanged">
    
    <Grid Background="#1B2631">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 主工作区 Canvas：承载所有 Normal 和 Maximized 子窗口，深色沉浸式点阵背景 -->
        <ItemsControl Grid.Row="0" x:Name="MdiItemsControl">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas x:Name="MdiCanvas" ClipToBounds="True" Background="#1B2631" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Left, Mode=TwoWay}" />
                    <Setter Property="Canvas.Top" Value="{Binding Top, Mode=TwoWay}" />
                    <Setter Property="Panel.ZIndex" Value="{Binding ZIndex, Mode=TwoWay}" />
                    <Setter Property="Width" Value="{Binding Width, Mode=TwoWay}" />
                    <Setter Property="Height" Value="{Binding Height, Mode=TwoWay}" />
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <!-- 最小化时在 Canvas 中隐藏 -->
                        <DataTrigger Binding="{Binding WindowState}" Value="{x:Static models:MdiWindowState.Minimized}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- 最大化时填满视口 -->
                        <DataTrigger Binding="{Binding WindowState}" Value="{x:Static models:MdiWindowState.Maximized}">
                            <Setter Property="Canvas.Left" Value="0" />
                            <Setter Property="Canvas.Top" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:MdiChildWindow />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 底部最小化窗口托盘区 (Windows 7 Aero 浅色卡片托盘) -->
        <Border Grid.Row="1" x:Name="MinimizedTray" Background="#E8EDF4" BorderBrush="#B2BCC9" BorderThickness="0,1,0,0" Padding="6,4">
            <ItemsControl x:Name="MinimizedItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F7F9FC" BorderBrush="#9DB3C8" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0" Padding="8,3">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.15" Color="#000000" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#1E395B" CornerRadius="2" Padding="3,1" Margin="0,0,6,0">
                                    <TextBlock Text=">_" Foreground="#4EC9B0" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Title}" Foreground="#1E395B" FontFamily="Segoe UI, Tahoma" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Button Command="{Binding RestoreCommand}" Background="Transparent" BorderThickness="0" Foreground="#2B4E74" ToolTip="还原窗口" Margin="0,0,4,0" Cursor="Hand">
                                    <TextBlock Text="❐" FontSize="11" />
                                </Button>
                                <Button Command="{Binding CloseCommand}" Background="Transparent" BorderThickness="0" Foreground="#C41E14" ToolTip="关闭窗口" Cursor="Hand">
                                    <TextBlock Text="✕" FontSize="10" FontWeight="Bold" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
