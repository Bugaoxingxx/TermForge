<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- MDI 子窗口与容器 Aero 样式规范 (AeroDockingTheme)                   -->
    <!-- ================================================================= -->

    <!-- 活动窗口 Aero 玻璃画刷 -->
    <LinearGradientBrush x:Key="MdiActiveGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E8F1FA" Offset="0.0" />
        <GradientStop Color="#C2E0F8" Offset="0.45" />
        <GradientStop Color="#9BC7EE" Offset="0.5" />
        <GradientStop Color="#CCE5FA" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 非活动窗口 Aero 玻璃画刷 (降饱和度冷灰蓝) -->
    <LinearGradientBrush x:Key="MdiInactiveGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EDF2F7" Offset="0.0" />
        <GradientStop Color="#D2DCE6" Offset="0.45" />
        <GradientStop Color="#BAC6D2" Offset="0.5" />
        <GradientStop Color="#D8E2EB" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 标题栏顶部半月形反光层 -->
    <LinearGradientBrush x:Key="MdiSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C0FFFFFF" Offset="0.0" />
        <GradientStop Color="#40FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="0.52" />
        <GradientStop Color="#25FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 边框画刷 -->
    <SolidColorBrush x:Key="MdiActiveBorderBrush" Color="#802672B5" />
    <SolidColorBrush x:Key="MdiInactiveBorderBrush" Color="#805C7E9C" />
    <SolidColorBrush x:Key="MdiHeaderSeparatorBrush" Color="#601A3654" />
    <SolidColorBrush x:Key="MdiViewportBackgroundBrush" Color="#0C0F14" />
    <SolidColorBrush x:Key="MdiWorkspaceBackgroundBrush" Color="#1B2631" />

    <!-- 最小化托盘画刷 -->
    <SolidColorBrush x:Key="MdiTrayBackgroundBrush" Color="#E8EDF4" />
    <SolidColorBrush x:Key="MdiTrayBorderBrush" Color="#B2BCC9" />
    <SolidColorBrush x:Key="MdiTaskButtonBackgroundBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="MdiTaskButtonBorderBrush" Color="#9DB3C8" />

    <!-- 标题文字发光与窗口阴影特效 -->
    <DropShadowEffect x:Key="MdiTitleGlowEffect" Color="#FFFFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.95" />
    <DropShadowEffect x:Key="MdiInactiveTitleGlowEffect" Color="#FFFFFF" BlurRadius="4" ShadowDepth="0" Opacity="0.75" />
    <DropShadowEffect x:Key="MdiActiveShadowEffect" Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.45" />
    <DropShadowEffect x:Key="MdiInactiveShadowEffect" Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.25" />

    <!-- 矢量图元 (避免因字体不同产生差异) -->
    <Geometry x:Key="MdiMinimizeGeometry">M 1,6 L 9,6</Geometry>
    <Geometry x:Key="MdiMaximizeGeometry">M 1,1 L 9,1 L 9,8 L 1,8 Z M 2,2 L 8,2 L 8,3 L 2,3 Z</Geometry>
    <Geometry x:Key="MdiRestoreGeometry">M 3,1 L 9,1 L 9,6 L 7,6 L 7,8 L 1,8 L 1,3 L 3,3 Z M 3,3 L 7,3 L 7,4 L 3,4 Z M 2,4 L 6,4 L 6,5 L 2,5 Z</Geometry>
    <Geometry x:Key="MdiCloseGeometry">M 1,1 L 9,9 M 9,1 L 1,9</Geometry>

</ResourceDictionary>
